{
  "manifest_version": 3,
  "name": "Social Media Auto Poster",
  "version": "2.0",
  "description": "Schedule posts to multiple platforms: CoinMarketCap, Binance Square, and more",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://coinmarketcap.com/*",
    "https://www.binance.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}